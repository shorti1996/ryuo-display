[Desktop Entry]
Type=Application
Name=RYUO Display
GenericName=Pump screen control
Comment=Tray icon, stats overlay and second-monitor mode for the ASUS ROG RYUO IV pump screen
Exec=/usr/bin/python3 @APPDIR@/ryuo_tray.py
Icon=ryuo-display
Terminal=false
StartupNotify=false
Categories=Utility;System;
Keywords=ryuo;rog;asus;cooler;aio;pump;oled;amoled;screen;display;monitor;stats;
Actions=open;

[Desktop Action open]
Name=Open control page
Exec=xdg-open http://127.0.0.1:8746/
