# ASUS ROG RYUO IV pump LCD: let the logged-in user open its HID control interface.
# The product ID is stable; the vendor ID is 0b05 on firmware 1.0.3/1.0.10 and 1c75 on 1.0.7.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="1c76", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="1c75", ATTRS{idProduct}=="1c76", TAG+="uaccess"
