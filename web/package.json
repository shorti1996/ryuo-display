{
  "name": "ryuo-lcd-web",
  "version": "0.0.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "The ryuod control page: Lit + TypeScript sources in src/, built by Vite into dist/, and its tests.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "demo": "vite --mode demo",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/roboto-condensed": "5.3.0",
    "happy-dom": "20.14.5",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  }
}
